{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default WEAVIA desktop capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://localhost:3000/*" }, { "url": "https://*.weavia.com/*" }]
    }
  ]
}
