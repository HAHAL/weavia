{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WEAVIA Desktop",
  "version": "0.1.0",
  "identifier": "com.weavia.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:live",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WEAVIA AI Commerce Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
