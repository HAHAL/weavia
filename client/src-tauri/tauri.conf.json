{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WEAVIA Desktop",
  "version": "0.3.1",
  "identifier": "com.weavia.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:live",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WEAVIA AI Commerce Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "resources": {
      "resources/codex": "codex",
      "resources/CODEX-LICENSE.txt": "CODEX-LICENSE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}