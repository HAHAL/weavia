# Development example only. Production deployment: docs/PRODUCTION.md.
# Public application configuration
NEXT_PUBLIC_APP_NAME=WEAVIA
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
VITE_API_BASE_URL=http://localhost:3000/api

# Development database only. Never commit a real credential.
DATABASE_URL=
POSTGRES_PASSWORD=
APP_ENV=development
DEMO_MODE=false
WEAVIA_BACKEND_URL=http://localhost:8080
BACKEND_ADDR=:8080
ASSET_STORAGE_DIR=./var/assets
STORAGE_SIGNING_KEY=

# Server-side provider placeholders. User-owned desktop keys must use Keychain/Credential Manager.
ALIBABA_API_KEY=
VOLCENGINE_API_KEY=
TENCENT_API_KEY=
AZURE_API_KEY=
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
OPENAI_API_KEY=

# Phase 2A server-only AI Gateway. Keep ENABLE_REAL_AI=false for CI and normal tests.
ANTDIGITAL_BASE_URL=https://maas-api.antdigital.com/v1
ANTDIGITAL_API_KEY=
ANTDIGITAL_IMAGE_MODEL=qwen-image-max
# Alibaba Cloud Model Studio Qwen Image Edit (server only).
# Prefer the workspace-specific /api/v1 host for the region of the API key.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_API_KEY=
DASHSCOPE_IMAGE_EDIT_MODEL=qwen-image-edit-plus
ENABLE_REAL_AI=false
AI_MAX_CONCURRENT_TASKS_PER_USER=1
AI_MAX_PROVIDER_ATTEMPTS=2
AI_PROVIDER_TIMEOUT_MS=120000

# Auth is database-backed. Never enable DEMO_MODE in production.
WEAVIA_DESKTOP_REDIRECT_URI=weavia://auth/callback
WEAVIA_WEB_ORIGIN=http://localhost:3000
