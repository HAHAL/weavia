# Public application configuration
NEXT_PUBLIC_APP_NAME=WEAVIA
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
VITE_API_BASE_URL=http://localhost:3000/api

# Development database only. Never commit a real credential.
DATABASE_URL=postgresql://weavia:weavia@localhost:5432/weavia

# Server-side provider placeholders. User-owned desktop keys must use Keychain/Credential Manager.
ALIBABA_API_KEY=
VOLCENGINE_API_KEY=
TENCENT_API_KEY=
AZURE_API_KEY=
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
OPENAI_API_KEY=

# Phase 2A server-only AI Gateway. Keep ENABLE_REAL_AI=false for CI and normal tests.
ANTDIGITAL_BASE_URL=https://maas-api.antdigital.com/v1
ANTDIGITAL_API_KEY=
ANTDIGITAL_IMAGE_MODEL=qwen-image-3.0-pro
ENABLE_REAL_AI=false
AI_MAX_CONCURRENT_TASKS_PER_USER=1
AI_MAX_PROVIDER_ATTEMPTS=2
AI_PROVIDER_TIMEOUT_MS=120000

# Auth placeholders
AUTH_SECRET=
WEAVIA_DESKTOP_REDIRECT_URI=weavia://auth/callback
WEAVIA_WEB_ORIGIN=http://localhost:3000
