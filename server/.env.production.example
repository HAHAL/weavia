# Export these variables in the deployment shell before running deploy.sh.
# Store real values outside Git and restrict access to the deployment account.
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/weavia?sslmode=verify-full
WEAVIA_WEB_ORIGIN=https://weavia.com
STORAGE_SIGNING_KEY=
AUTH_VERIFICATION_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ENABLE_REAL_AI=false
ANTDIGITAL_API_KEY=
DASHSCOPE_API_KEY=
BACKUP_DIR=/var/backups/weavia
