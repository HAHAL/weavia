# Temporary acceptance uses a local hosts entry, so Caddy issues an internal
# certificate. Trust its root CA only for this isolated test environment.
yaoyaoai.asia {
	tls internal

	@admin path /admin /admin/*
	handle @admin {
		uri strip_prefix /admin
		reverse_proxy admin:80
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy web:3000
	}
}
