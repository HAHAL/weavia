{
  "name": "weavia-v2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "db:generate": "pnpm --filter @weavia/database db:generate",
    "db:migrate": "pnpm --filter @weavia/database db:migrate",
    "backend:test": "cd services/backend && go test ./...",
    "backend:vet": "cd services/backend && go vet ./...",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^3.2.4"
  }
}