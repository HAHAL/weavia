{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weavia.local/schemas/export-manifest-v1.json",
  "title": "WEAVIA export manifest v1",
  "type": "object",
  "required": ["format", "version", "exportedAt", "works"],
  "properties": {
    "format": { "const": "weavia.export" },
    "version": { "const": 1 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "appVersion": { "type": "string" },
    "deviceId": { "type": "string" },
    "works": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "mode", "createdAt", "versions"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "mode": { "enum": ["image", "video"] },
          "productId": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "cover": { "type": "string" },
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "versionNo", "file", "sha256", "mime", "size"],
              "properties": {
                "id": { "type": "string" },
                "versionNo": { "type": "integer", "minimum": 1 },
                "prompt": { "type": "string" },
                "file": { "type": "string" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "mime": { "type": "string" },
                "size": { "type": "integer", "minimum": 1 },
                "createdAt": { "type": "string", "format": "date-time" },
                "cloudVersionId": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "sha256", "mime", "size"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "file": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "mime": { "type": "string" },
          "size": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "conversations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "messages"],
        "properties": {
          "id": { "type": "string" },
          "serverId": { "type": "string" },
          "title": { "type": "string" },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "role", "content", "createdAt"],
              "properties": {
                "id": { "type": "string" },
                "role": { "enum": ["user", "assistant", "system"] },
                "content": { "type": "string" },
                "params": { "type": "object" },
                "attachments": { "type": "array" },
                "taskId": { "type": "string" },
                "createdAt": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      }
    }
  }
}
